{
  "name": "colony-gladiator",
  "version": "1.0.0",
  "description": "Colony Gladiator — a bug-battle campaign, battle maker and sandbox on one deterministic simulation engine.",
  "type": "module",
  "main": "engine/index.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build": "node tools/buildStatic.js",
    "serve:portal": "node tools/servePortal.js",
    "headless": "node examples/headless.js",
    "prices": "node tools/priceReport.js",
    "sim": "node tools/simRun.js",
    "probe": "node tools/balanceProbe.js",
    "calibrate": "node tools/calibrate.js",
    "tune": "node tools/tuneIncome.js",
    "sprites:svg": "node tools/rasterizeSvgs.js",
    "sprites:pixel": "node tools/genPlaceholderSprites.js",
    "levels": "node tools/levelReport.js",
    "campaign": "node tools/campaignProbe.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "simulation",
    "matter-js",
    "physics",
    "sandbox",
